{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlubberBound",
  "version": "1.0.0",
  "identifier": "com.mkiera.blubberbound",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"BlubberBound","width":1180,"height":900,"minWidth":1000,"minHeight":900,"center":true}],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {"enable":true,"scope":[]}
    }
  },
  "bundle": {"active":false,"icon":["../icon.ico"]}
}
